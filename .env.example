# Copy this file to .env (repo root) and fill in real values. .env is gitignored.
#
# Nothing here is required: with no .env the server still boots, mints a random
# TOTP_SECRET per boot, and generates strong random demo passwords on first seed
# (printed once to the console). Set the passwords below to fix them for a demo.

# ---- backend ----
PORT=4000
# Origins allowed to call the API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Secret used to derive rotating check-in codes. Leave unset for a random per-boot
# secret; set a long random string so codes survive restarts / run across instances.
TOTP_SECRET=

# Seeded demo credentials. Leave blank to let the server generate + print them.
DEMO_MEMBER_PASSWORD=
DEMO_ADMIN_PASSWORD=demo1234

# Session and password-hashing parameters.
SESSION_TTL_H=12
ADMIN_TTL_H=4
PBKDF2_ITERATIONS=210000

# SQLite database file, relative to backend/.
DB_PATH=data/collabsphere.sqlite
