# Copy to .env (frontend/) to point the UI at the API. Vite reads VITE_* from here.
# With no .env the UI falls back to the offline localStorage prototype.

# Talk to the API (via the dev proxy below, or set VITE_API_BASE_URL for another origin).
VITE_USE_API=1

# Dev-server proxy target for /api. Same-origin means no CORS and a tight CSP.
VITE_API_PROXY=http://localhost:4000

# Set this only when the API is on a different origin than the app.
VITE_API_BASE_URL=
